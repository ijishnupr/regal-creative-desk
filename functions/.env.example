# Copy to functions/.env and fill in.

# ID of the Google Drive folder where uploads are stored.
# Open the folder in Drive: https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=

# Optional: anyone signing in with this email domain is auto-added as a Designer
# (leave empty to allow only invited emails).
ALLOWED_DOMAIN=

# Max upload size in MB (Cloud Functions hard limit is 32 MB per request).
MAX_UPLOAD_MB=25

# ---- Drive auth ----
# Option A (recommended, Google Workspace): leave the three values below empty.
#   The function's service account is used. Add that service account as a
#   "Content manager" of a Shared Drive and put DRIVE_FOLDER_ID inside it.
#
# Option B (personal Gmail / no Shared Drive): OAuth refresh token of the
#   Google account that owns the folder. See README "Drive option B".
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=
