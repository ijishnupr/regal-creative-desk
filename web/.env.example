# Firebase console -> Project settings -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Functions region (must match functions/src/index.ts)
VITE_FUNCTIONS_REGION=asia-south1

# Optional: set to "true" to use local Firebase emulators during `npm run dev`
VITE_USE_EMULATORS=false

# Dev only: where /api is proxied (deployed hosting URL or emulator)
VITE_DEV_API_TARGET=http://127.0.0.1:5000
