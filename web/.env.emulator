# Used by `npm run dev:emu` — talks to local Firebase emulators only.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-regal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-regal
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FUNCTIONS_REGION=asia-south1
VITE_USE_EMULATORS=true
VITE_DEV_API_TARGET=http://127.0.0.1:5000

# Emulator mode talks to the local hosting emulator
VITE_API_BASE=/api
